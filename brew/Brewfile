# Brewfile - Homebrew Bundle for package management
# Install with: brew bundle --file=brew/Brewfile
#
# Synced from this machine with `brew bundle dump` (2026-09-19); the curated
# section layout is kept by hand. Re-sync by dumping to a scratch file and
# folding new entries into the right section rather than overwriting this one.

# ============================================================================
# Taps
# ============================================================================

# Note: homebrew/cask is no longer needed - casks work automatically
# Note: homebrew/cask-fonts was deprecated - fonts are now in homebrew/cask
# Note: a few work-specific taps and formulae installed on this machine are
# deliberately absent — this repo is public and they match the private
# denylist enforced by claude/scripts/check-public.sh.
tap "hashicorp/tap"
tap "hudochenkov/sshpass"
tap "minio/stable"

