{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(cut:*)",
      "Bash(paste:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tee:*)",
      "Bash(echo:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pytest:*)",
      "Bash(sqlite3:*)",
      "Bash(timeout:*)",
      "Bash(time:*)",
      "Bash(source:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "Bash(lsof:*)",
      "Bash(ruff:*)",
      "Bash(brew:*)",
      "Bash(pipx:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/python3:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/vulture:*)",
      "WebSearch"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-frontmatter-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-access-tracker.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true
}
